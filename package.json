    "preview": "vite preview",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pixi.js": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
