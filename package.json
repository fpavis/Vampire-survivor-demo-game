{
  "name": "survival-game",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery": "node scripts/gallery.mjs gallery-out",
    "preview": "vite preview",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/phase1.mjs && node tests/e2e/phase2.mjs && node tests/e2e/phase3.mjs && node tests/e2e/phase4.mjs && node tests/e2e/phase5.mjs && node tests/e2e/phase6.mjs && node tests/e2e/input.mjs",
    "build:artifact": "npm run build:single && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "fflate": "^0.8.3",
    "pixi.js": "^7.4.3",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
